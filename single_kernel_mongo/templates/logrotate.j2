{{logs_directory}}/mongodb.log
{
    rotate {{max_rotations}}
    size {{max_log_size}}
    missingok
    notifempty
    create 0600 {{mongo_user}} {{mongo_user}}
    compress
    delaycompress
    nomail
    nocopytruncate
    sharedscripts
    postrotate
        uri={{get_uri}}
        if [ -z "${uri}" ]; then
            echo "ERROR: logrotate URI is empty or missing" >&2
            exit 1
        fi
        echo "Logrotate URI is set"

        {{shell}} "${uri}" --quiet --eval \
            'const r = db.adminCommand({logRotate: "server"}); printjson(r); quit(r.ok === 1 ? 0 : 1);'

        rc=$?
        echo "MongoDB logRotate exit code: $rc"
        exit "$rc"
    endscript
}
