{{logs_directory}}/mongodb.log
{
    rotate {{max_rotations}}
    size {{max_log_size}}
    missingok
    notifempty
    create 0600 {{mongo_user}} {{mongo_user}}
    compress
    delaycompress
    nomail
    nocopytruncate
    sharedscripts
    postrotate
        uri={{get_uri}}
        {{shell}} ${uri} --quiet --eval "db.adminCommand({logRotate: 'server'})"
    endscript
}
{{logs_directory}}/mongos.log
{
    rotate {{max_rotations}}
    size {{max_log_size}}
    missingok
    notifempty
    create 0600 {{mongo_user}} {{mongo_user}}
    compress
    delaycompress
    nomail
    nocopytruncate
    sharedscripts
    postrotate
        uri={{get_uri}}
        mongos_uri="$(echo ${uri} | sed 's/27017/27018/')"
        {{shell}} ${mongos_uri} --quiet --eval "db.adminCommand({logRotate: 'server'})"
    endscript
}
